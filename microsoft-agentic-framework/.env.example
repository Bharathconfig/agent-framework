# =============================================================================
#  Microsoft Agentic Framework - environment configuration
# =============================================================================
#  1. Copy this file to ".env" (same folder):   cp .env.example .env
#  2. Fill in the TWO required values below.
#  3. Run any example, e.g.:                    python run_example.py 1
#
#  ".env" is git-ignored, so your secrets are never committed.
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------
# Azure Portal -> your Azure OpenAI resource -> "Keys and Endpoint"
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/

# ---- OPTIONAL (defaults shown) ----------------------------------------------
# The *deployment name* of your chat model (Azure AI Foundry -> Deployments).
# It must support tool/function calling and structured outputs
# (gpt-4o, gpt-4o-mini, gpt-4.1, gpt-4.1-mini, ... all work).
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure OpenAI REST API version.
AZURE_OPENAI_API_VERSION=2024-10-21
